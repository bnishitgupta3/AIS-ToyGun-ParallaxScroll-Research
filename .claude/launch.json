{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "start"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "cs-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-s", "frontend/build", "-l", "5050"],
      "port": 5050,
      "autoPort": true
    }
  ]
}
