# Copy to ".env" (or set in your host's env) and fill in real values.
# CRA only exposes variables prefixed with REACT_APP_ to the browser.

# Google Analytics 4 Measurement ID (Admin -> Data Streams -> your web stream).
# Without this, analytics is disabled (no GA script loads).
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# WhatsApp support button. Your WhatsApp Business number managed by Interakt,
# as country code + number, DIGITS ONLY (no "+", no spaces), e.g. 919876543210.
# While this is empty the floating "Chat with us" button does not render, so
# nothing half-wired ships. Set it once the Interakt number is live.
REACT_APP_WHATSAPP_NUMBER=
